<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:label="tracive_sdk_example"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!-- The OAuth redirect target; see doc/oauth.md.
                 An App Link, not a custom scheme: a custom scheme is claimed
                 first-come, so any other app on the device could register the
                 same one and receive the authorization code.

                 `autoVerify="true"` requires https://example.tracive.id to
                 serve /.well-known/assetlinks.json naming this package and its
                 signing-certificate fingerprint. This demo does not control
                 that host, so verification will not succeed here — replace the
                 host with one you own. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data
                    android:scheme="https"
                    android:host="example.tracive.id"
                    android:pathPrefix="/oauth/callback"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>

        <!-- Package visibility for the Tracive SDK — doc/oauth.md.
             On Android 11+ (API 30) `canLaunchUrl` returns false for any app
             you have not declared here, installed or not. Without this block
             the SDK's app-presence pre-check reports "not installed" for
             everybody, and every user is sent to the install link instead of
             the consent screen.

             One entry per scheme the probe may use, because the probe follows
             `environment`: `tracive` is the production app, `tracivedev` the
             sandbox build. A `<package>` entry would name one build and so
             could not follow it. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="tracive"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="tracivedev"/>
        </intent>
        <!-- url_launcher needs this to open the Custom Tab and the install
             link. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
    </queries>
</manifest>
