<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:label="${appLabel}"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!-- app_links delivers the redirect to Dart. Flutter's own deep
                 linking would also push it onto the Navigator as a route
                 name, which this app has no route for. -->
            <meta-data
                android:name="flutter_deeplinking_enabled"
                android:value="false" />

            <!-- The OAuth redirect target; see doc/oauth.md. The scheme is
                 per flavor, from productFlavors in build.gradle.kts, and has
                 to match lib/flavor.dart.

                 A private-use scheme only because this example controls no
                 domain. Any app on the device can claim one, so a real
                 integration uses an App Link it owns — SECURITY.md.

                 TODO(partner): an App Link on a host you own, with
                 android:autoVerify="true" and assetlinks.json served there. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data
                    android:scheme="${traciveRedirectScheme}"
                    android:host="oauth"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>

        <!-- Package visibility for the Tracive SDK — doc/oauth.md.
             On Android 11+ (API 30) `canLaunchUrl` returns false for any app
             you have not declared here, installed or not. Without this block
             the SDK's app-presence pre-check reports "not installed" for
             everybody, and every user is sent to the install link instead of
             the consent screen.

             One entry per scheme the probe may use, because the probe follows
             `environment`: `tracive` is the production app, `tracivesandbox`
             the sandbox build. A `<package>` entry would name one build and so
             could not follow it. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="tracive"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="tracivesandbox"/>
        </intent>
        <!-- url_launcher needs this to open the Custom Tab and the install
             link. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
    </queries>
</manifest>
